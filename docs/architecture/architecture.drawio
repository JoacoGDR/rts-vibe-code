        <mxCell id="title4" value="engine — External Interactions" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="400" y="20" width="550" height="40" as="geometry" />
        </mxCell>
        <!-- Central service -->
