        <!-- Central service -->
        <mxCell id="ab6_bot" value="ai-bot :8084" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="560" y="380" width="200" height="70" as="geometry" />
        </mxCell>
        <!-- Trigger explanation (top center) -->
        <mxCell id="ab6_trigger" value="Activated by: bot_takeover event&#xa;Worker publishes via NATS → gateway delivers&#xa;over WS to the connected ai-bot session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="510" y="190" width="300" height="70" as="geometry" />
        </mxCell>
        <!-- Services it calls (left) -->
        <mxCell id="ab6_coreapi" value="core-api :8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="120" y="280" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ab6_gateway" value="gateway :8081" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="120" y="480" width="180" height="60" as="geometry" />
        </mxCell>
        <!-- PostgreSQL (right) -->
        <mxCell id="ab6_pg" value="PostgreSQL&#xa;match data (read)&#xa;slot selection" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="970" y="340" width="190" height="140" as="geometry" />
        </mxCell>
        <!-- Edges: ai-bot → core-api (merged, two separate exit points) -->
        <mxCell id="ab6_e1" value="POST /auth/login-as-bot (bot API key)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" parent="1" source="ab6_bot" target="ab6_coreapi" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ab6_e2" value="POST /auth/ws-ticket (JWT)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" parent="1" source="ab6_bot" target="ab6_coreapi" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- ai-bot → gateway -->
        <mxCell id="ab6_e3" value="WebSocket (same protocol as human players)&#xa;sends: command envelopes&#xa;receives: state / event envelopes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="ab6_bot" target="ab6_gateway" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- ai-bot → postgres -->
        <mxCell id="ab6_e4" value="SQL read (match_players, matches)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="ab6_bot" target="ab6_pg" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- ADR note -->
        <mxCell id="ab6_note" value="ADR-0004: ai-bot is a headless WebSocket client identical in protocol to human players. Bot heuristic emits ClientCommand envelopes; same rate limiting and validation applies." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="80" y="720" width="1240" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
